# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=SentinelDesk
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel_desk?schema=public

# ── Redis ─────────────────────────────────────────────────────────────
# Mapped to host port 6380 (not the 6379 default) to avoid colliding with
# other local projects that may already have a Redis instance running.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

# ── Cookies ───────────────────────────────────────────────────────────
COOKIE_SECRET=dev_cookie_secret_change_me_min_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── Mail (SMTP — MailHog in dev) ─────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SentinelDesk <no-reply@sentineldesk.local>"
SMTP_SECURE=false

# ── Object storage (MinIO / S3-compatible) ───────────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=sentinel_minio
STORAGE_SECRET_KEY=sentinel_minio_password
STORAGE_BUCKET=sentinel-desk
STORAGE_REGION=us-east-1

# ── AI provider ───────────────────────────────────────────────────────
# Provider: "anthropic" | "openai" | "mock"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ─────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Frontend (Next.js public) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=SentinelDesk

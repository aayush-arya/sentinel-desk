// SentinelDesk — Prisma schema
// Milestone 1 scope: multi-tenant root (Organization) + Auth/RBAC.
// Later milestones extend this file with Ticket, SLA, KB, etc. models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  domain           String?  @unique
  logoUrl          String?
  primaryColor     String   @default("#6366F1")
  timezone         String   @default("UTC")
  settings         Json     @default("{}")
  // Incremented transactionally on ticket creation to hand out gapless, human-friendly
  // per-org ticket numbers (#1, #2, ...) without racing on a MAX(number) query.
  nextTicketNumber Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                  User[]
  auditLogs              AuditLog[]
  tickets                Ticket[]
  tags                   Tag[]
  businessHoursSchedules BusinessHoursSchedule[]
  slaPolicies            SlaPolicy[]
  notifications          Notification[]
  knowledgeArticles      KnowledgeArticle[]
  macros                 Macro[]
  webhooks               Webhook[]
  apiKeys                ApiKey[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────
// RBAC
// ─────────────────────────────────────────────────────────────────────

enum RoleName {
  CUSTOMER
  AGENT
  SENIOR_AGENT
  MANAGER
  ADMIN
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  label       String
  description String
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────
// Users & sessions
// ─────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String     @unique
  passwordHash   String?
  firstName      String
  lastName       String
  avatarUrl      String?
  title          String?
  phone          String?
  status         UserStatus @default(PENDING_VERIFICATION)
  roleId         String
  timezone       String     @default("UTC")
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  inviteTokens            InviteToken[]
  auditLogs               AuditLog[]
  ticketsRequested        Ticket[]                 @relation("TicketRequester")
  ticketsAssigned         Ticket[]                 @relation("TicketAssignee")
  comments                Comment[]
  ticketHistoryEntries    TicketHistory[]
  notifications           Notification[]
  knowledgeArticles       KnowledgeArticle[]
  macros                  Macro[]
  savedFilters            SavedFilter[]
  apiKeysCreated          ApiKey[]
  watchedTickets          TicketWatcher[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  deviceLabel      String?
  isRememberMe     Boolean   @default(false)
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model InviteToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invite_tokens")
}

// ─────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_REPLY
  SLA_BREACHED
  SLA_ESCALATED
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String
  ticketId       String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([organizationId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id              String         @id @default(uuid())
  organizationId  String
  number          Int
  subject         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  requesterId     String
  assigneeId      String?
  mergedIntoId    String?
  splitFromId     String?
  reopenedCount   Int            @default(0)
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  // SLA tracking — see apps/backend/src/sla/sla.service.ts for how these are computed
  // and kept in sync as the ticket moves through statuses.
  slaPolicyId        String?
  responseDueAt      DateTime?
  resolutionDueAt    DateTime?
  responseBreached   Boolean   @default(false)
  resolutionBreached Boolean   @default(false)
  slaPausedAt        DateTime?
  slaEscalatedAt     DateTime?

  // Customer satisfaction — set once by the requester after the ticket is
  // RESOLVED/CLOSED (see tickets/csat.service.ts). 1-5, never staff-editable.
  csatRating  Int?
  csatComment String?
  csatRatedAt DateTime?

  // Advisory only, set once asynchronously right after creation (see
  // ai/ai-enrichment.processor.ts) — never overwrites the real priority/tags an
  // agent or the requester chose. Surfaced in the UI as a suggestion to accept or ignore.
  aiSuggestedPriority TicketPriority?
  aiSuggestedTags     String[]        @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  slaPolicy    SlaPolicy?   @relation(fields: [slaPolicyId], references: [id])

  mergedInto    Ticket?  @relation("TicketMerge", fields: [mergedIntoId], references: [id])
  mergedTickets Ticket[] @relation("TicketMerge")
  splitFrom     Ticket?  @relation("TicketSplit", fields: [splitFromId], references: [id])
  splitTickets  Ticket[] @relation("TicketSplit")

  comments      Comment[]
  tags          TicketTag[]
  history       TicketHistory[]
  notifications Notification[]
  watchers      TicketWatcher[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([responseDueAt])
  @@index([resolutionDueAt])
  @@map("tickets")
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Comment {
  id         String            @id @default(uuid())
  ticketId   String
  authorId   String
  visibility CommentVisibility @default(PUBLIC)
  body       String
  createdAt  DateTime          @default(now())
  editedAt   DateTime?

  // Set asynchronously after creation (see ai/ai-enrichment.processor.ts) for
  // PUBLIC comments from customers only — an agent's own tone isn't a useful signal.
  sentiment CommentSentiment?

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(uuid())
  commentId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("attachments")
}

model Tag {
  id             String @id @default(uuid())
  organizationId String
  name           String
  color          String @default("#6366F1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets      TicketTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@map("ticket_tags")
}

enum TicketHistoryAction {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  TRANSFERRED
  ESCALATED
  TAG_ADDED
  TAG_REMOVED
  MERGED
  MERGED_FROM
  SPLIT
  REOPENED
  COMMENT_ADDED
  NOTE_ADDED
  SLA_PAUSED
  SLA_RESUMED
  RESPONSE_SLA_BREACHED
  RESOLUTION_SLA_BREACHED
  AUTO_ESCALATED
}

model TicketWatcher {
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@map("ticket_watchers")
}

model TicketHistory {
  id        String              @id @default(uuid())
  ticketId  String
  actorId   String?
  action    TicketHistoryAction
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_history")
}

// ─────────────────────────────────────────────────────────────────────
// SLA engine — business hours, holidays, and per-priority targets
// ─────────────────────────────────────────────────────────────────────

model BusinessHoursSchedule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  timezone       String   @default("UTC")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slots        BusinessHoursSlot[]
  holidays     Holiday[]
  slaPolicies  SlaPolicy[]

  @@index([organizationId])
  @@map("business_hours_schedules")
}

model BusinessHoursSlot {
  id          String @id @default(uuid())
  scheduleId  String
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek   Int
  /// Minutes since local midnight (schedule.timezone), e.g. 9:00am = 540
  startMinute Int
  endMinute   Int

  schedule BusinessHoursSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("business_hours_slots")
}

model Holiday {
  id         String   @id @default(uuid())
  scheduleId String
  /// Stored as midnight UTC representing a calendar date — time-of-day is not meaningful here
  date       DateTime
  name       String

  schedule BusinessHoursSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@map("holidays")
}

model SlaPolicy {
  id                      String   @id @default(uuid())
  organizationId          String
  name                    String
  isDefault               Boolean  @default(false)
  businessHoursScheduleId String
  /// Auto-escalate a ticket once this % of its resolution window has elapsed unresolved
  autoEscalateAtPercent   Int      @default(80)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours BusinessHoursSchedule @relation(fields: [businessHoursScheduleId], references: [id])
  rules         SlaPolicyRule[]
  tickets       Ticket[]

  @@index([organizationId])
  @@map("sla_policies")
}

model SlaPolicyRule {
  id                      String         @id @default(uuid())
  policyId                String
  priority                TicketPriority
  responseTargetMinutes   Int
  resolutionTargetMinutes Int

  policy SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, priority])
  @@map("sla_policy_rules")
}

// ─────────────────────────────────────────────────────────────────────
// Knowledge base
// ─────────────────────────────────────────────────────────────────────

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeArticle {
  id             String                 @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  slug           String
  // Sanitized HTML from the same TipTap editor + sanitize-html.util.ts pipeline as
  // comment bodies — never raw user input.
  body           String
  status         KnowledgeArticleStatus @default(DRAFT)
  viewCount      Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("knowledge_articles")
}

// ─────────────────────────────────────────────────────────────────────
// Saved replies (macros) & saved filters
// ─────────────────────────────────────────────────────────────────────

model Macro {
  id             String   @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@map("macros")
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  name      String
  // Arbitrary QueryTicketsDto-shaped filter state (status/priority/assignee/search/etc)
  // - a personal view, not something other roles need to see or the schema needs to
  // model field-by-field.
  filters   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_filters")
}

// ─────────────────────────────────────────────────────────────────────
// Webhooks & public API keys
// ─────────────────────────────────────────────────────────────────────

model Webhook {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  // HMAC-SHA256 signing secret for the X-SentinelDesk-Signature header - lets a
  // receiver verify the payload actually came from us, not a spoofed request.
  secret         String
  events         String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhooks")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  createdById    String
  name           String
  // SHA-256 of the actual key - only the prefix is kept in the clear so the UI can
  // show "sk_live_ab12••••" without ever being able to redisplay the full secret.
  keyHash        String    @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}
